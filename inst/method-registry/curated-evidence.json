    "etr_transform_fpca": {
      "tier": "core",
      "family": "functional interpretation",
      "evidence_status": "numerically_checked",
      "backend": "native-R",
      "caveat": "Project onto training-fitted basis to avoid test leakage.",
      "evidence": "docs/SCIENTIFIC_VALIDATION_RESULTS_20261117.md"
    },
    "etr_reconstruct_fpca": {
      "tier": "core",
      "family": "functional interpretation",
      "evidence_status": "numerically_checked",
      "backend": "native-R",
      "caveat": "Low-rank reconstruction does not recreate missing raw measurements.",
      "evidence": "docs/SCIENTIFIC_VALIDATION_RESULTS_20261117.md"
    },
    "etr_plot_trajectories": {
      "tier": "core",
      "family": "core visualization",
      "evidence_status": "source_contract_tested",
      "backend": "native-R",
      "caveat": "Check plot axes, channel scales and synthetic/real labeling.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
