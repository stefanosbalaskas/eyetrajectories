    },
    "etr_fit_fpca": {
      "tier": "core",
      "family": "functional decomposition",
      "evidence_status": "numerically_checked",
      "backend": "native-R",
      "caveat": "Descriptive eigenfunctions are not inferential confidence bands.",
      "evidence": "docs/SCIENTIFIC_VALIDATION_RESULTS_20261117.md"
