      "family": "sparse FPCA",
      "evidence_status": "bounded_known_truth_recovery",
      "backend": "r-delegated-fdapace",
      "caveat": "Delegates to optional fdapace; one-factor recovery is not general estimator certification.",
      "evidence": "docs/SCIENTIFIC_VALIDATION_RESULTS_20261117.md"
    },
    "etr_sparse_pace_scores": {
      "tier": "advanced",
      "family": "sparse FPCA",
      "evidence_status": "backend_parity",
      "backend": "r-delegated-fdapace",
      "caveat": "Conditional expectation scores under the delegated PACE model.",
