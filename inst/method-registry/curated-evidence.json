{
  "schema": "eyetrajectories-method-registry/v1",
  "source_release": "v0.4.3",
  "classification_policy": "Tier describes intended methodological role; evidence_status separately describes observed validation scope; no catch-all scientific certification.",
  "unclassified_policy": {
    "tier": "experimental",
    "evidence_status": "not_independently_assessed",
    "family": "other_or_specialized",
    "caveat": "No method-specific independent scientific validation claim is assigned. Inspect the reference documentation and original implementation."
  },
  "backend_policy": {
    "etr": "native-R unless specifically marked otherwise",
    "etpy": "python-bridge; requires separately installed eyetrajectoriespy",
    "et": "hybrid R/Python facade; inspect exact function"
  },
  "evidence_sources": [
    "https://github.com/stefanosbalaskas/eyetrajectories/blob/main/docs/SCIENTIFIC_VALIDATION_RESULTS_20261117.md",
    "https://github.com/stefanosbalaskas/eyetrajectories/blob/main/docs/POTEC_REAL_SOURCE_AND_L2_RESULTS_20261118.md"
  ],
  "method_overrides": {
    "etr_trajectory_set": {
      "tier": "core",
      "family": "data representation",
      "evidence_status": "source_contract_tested",
      "backend": "native-R",
      "caveat": "Explicit common-grid trajectory objects, channel units and identifiers; input correctness depends on declared source mapping.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
    },
    "etr_validate": {
      "tier": "core",
      "family": "validation",
      "evidence_status": "source_contract_tested",
      "backend": "native-R",
      "caveat": "Structural and numerical input checks do not establish external eye-tracker calibration.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
    },
    "etr_from_long": {
      "tier": "core",
      "family": "data representation",
      "evidence_status": "source_contract_tested",
      "backend": "native-R",
      "caveat": "Requires correct participant/trial grouping and time-grid specification.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
    },
    "etr_as_long": {
      "tier": "core",
      "family": "data representation",
      "evidence_status": "source_contract_tested",
      "backend": "native-R",
      "caveat": "Conversion is not an independent provenance audit.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
    },
    "etr_subset": {
      "tier": "core",
      "family": "data representation",
      "evidence_status": "source_contract_tested",
      "backend": "native-R",
      "caveat": "Selection and subject grouping must be verified.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
    },
    "etr_dimension": {
      "tier": "core",
      "family": "data representation",
      "evidence_status": "source_contract_tested",
      "backend": "native-R",
      "caveat": "Channels require declared compatible physical units.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
    },
    "etr_summary": {
      "tier": "core",
      "family": "validation",
      "evidence_status": "source_contract_tested",
      "backend": "native-R",
      "caveat": "Descriptive summaries do not establish source-event truth.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
    },
    "etr_resample": {
      "tier": "core",
      "family": "preprocessing",
      "evidence_status": "source_contract_tested",
      "backend": "native-R",
      "caveat": "Interpolation alters the observation process; retain original sampling record.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
    },
    "etr_interpolate_gaps": {
      "tier": "core",
      "family": "preprocessing",
      "evidence_status": "source_contract_tested",
      "backend": "native-R",
      "caveat": "Do not fill prolonged eye-tracking loss without explicit limits.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
    },
    "etr_normalize_time": {
      "tier": "core",
      "family": "preprocessing",
      "evidence_status": "source_contract_tested",
