    "etr_fit_mfpca": {
      "tier": "core",
      "family": "functional decomposition",
      "evidence_status": "numerically_checked",
      "backend": "native-R",
      "caveat": "Scores depend on scaling, rank and observation grid.",
      "evidence": "docs/SCIENTIFIC_VALIDATION_RESULTS_20261117.md"
    },
    "etr_fpca_scores": {
      "tier": "core",
      "family": "functional interpretation",
      "evidence_status": "numerically_checked",
      "backend": "native-R",
      "caveat": "Component signs may reverse without changing model.",
      "evidence": "docs/SCIENTIFIC_VALIDATION_RESULTS_20261117.md"
    },
    "etr_fpca_variance_frame": {
      "tier": "core",
      "family": "functional interpretation",
      "evidence_status": "source_contract_tested",
      "backend": "native-R",
      "caveat": "Explained variance is descriptive and depends on preprocessing.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
