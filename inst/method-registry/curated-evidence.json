    },
    "etr_sparse_pace_fitted": {
      "tier": "advanced",
      "family": "sparse FPCA",
      "evidence_status": "bounded_known_truth_recovery",
      "backend": "r-delegated-fdapace",
      "caveat": "Reconstruction assessed only under selected synthetic designs.",
