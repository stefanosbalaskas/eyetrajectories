      "evidence": "docs/SCIENTIFIC_VALIDATION_RESULTS_20261117.md"
    },
    "etr_l2_distance": {
      "tier": "core",
      "family": "trajectory distances",
      "evidence_status": "numerically_checked",
      "backend": "native-R",
      "caveat": "Weighted distance assumes channel units and quadrature are commensurable.",
      "evidence": "docs/SCIENTIFIC_VALIDATION_RESULTS_20261117.md"
    },
    "etr_pairwise_l2": {
      "tier": "core",
      "family": "trajectory distances",
      "evidence_status": "bounded_real_data_benchmark",
