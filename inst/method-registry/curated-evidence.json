      "caveat": "Normalized within-trial time is not acquisition time.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
    },
    "etr_center": {
      "tier": "core",
      "family": "preprocessing",
      "evidence_status": "source_contract_tested",
      "backend": "native-R",
      "caveat": "Centering changes the interpretand and must be declared.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
    },
    "etr_smooth": {
      "tier": "core",
      "family": "preprocessing",
      "evidence_status": "source_contract_tested",
      "backend": "native-R",
      "caveat": "Smoothing and temporal resolution alter high-frequency behavior.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
    },
    "etr_scale_channels": {
      "tier": "core",
      "family": "preprocessing",
      "evidence_status": "source_contract_tested",
      "backend": "native-R",
      "caveat": "Channel scaling must be scientifically justified.",
      "evidence": "docs/EMPIRICAL_VALIDATION_STATUS_20261117.md"
