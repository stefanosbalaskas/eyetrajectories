\name{etr_plot_recurrence_network_degree}
\alias{etr_plot_recurrence_network_degree}
\title{Plot normalized or raw recurrence network degree source artists}
\usage{
etr_plot_recurrence_network_degree(result, normalized = TRUE, strict_source_record = FALSE, ...)
}
\arguments{
\item{result}{Native precomputed recurrence network.}\item{normalized}{Logical: normalized degree rather than raw vertex degree.}\item{strict_source_record}{Logical scalar selecting source scientific artist coordinates.}\item{...}{Legacy base R graphics options.}
}
\value{Native default invisibly returns zero-based state indices and selected degree; strict mode returns matching source Matplotlib line geometry and density-annotated title.}
\description{Native scientific geometry for the frozen Python 1.2 nonlinear plotting contract. Scientific estimators and the default base R graphics return are unchanged.}
\details{The strict source record does not return a live Python Matplotlib Axes, accept arbitrary Python dataclasses, reproduce Python exception classes, or establish pixel parity. No independent full-contract certification is claimed.}
